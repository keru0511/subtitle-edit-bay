{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtitle-edit-bay.local/schemas/codex_action.schema.json",
  "title": "Subtitle Edit Bay Codex Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "type", "args", "scope_id"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["inspect", "propose", "execute"]},
    "type": {"type": "string", "minLength": 1},
    "args": {"type": "object"},
    "scope_id": {"type": "string", "minLength": 1},
    "project_revision": {"type": "integer", "minimum": 0}
  }
}
